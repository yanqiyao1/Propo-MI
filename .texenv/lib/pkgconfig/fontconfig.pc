prefix=/home/qiyaoyan/Propologic-MI/.texenv
includedir=${prefix}/include
libdir=${prefix}/lib

sysconfdir=/home/qiyaoyan/Propologic-MI/.texenv/etc
localstatedir=/home/qiyaoyan/Propologic-MI/.texenv/var
confdir=/home/qiyaoyan/Propologic-MI/.texenv/etc/fonts
cachedir=/home/qiyaoyan/Propologic-MI/.texenv/var/cache/fontconfig

Name: Fontconfig
Description: Font configuration and customization library
Version: 2.17.1
Requires.private: freetype2 >=  21.0.15, expat
Libs: -L${libdir} -lfontconfig
Libs.private: -pthread -lm
Cflags: -I${includedir}
