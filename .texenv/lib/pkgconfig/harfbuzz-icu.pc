includedir=${prefix}/include
libdir=${prefix}/lib

Name: harfbuzz-icu
Description: HarfBuzz text shaping library ICU integration
Version: 13.2.1
Requires: harfbuzz =  13.2.1
Requires.private: icu-uc >=  49.0
